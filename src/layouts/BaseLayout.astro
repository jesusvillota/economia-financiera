---
import '../styles/global.css';
import ThemeToggle from '../components/layout/ThemeToggle.astro';
import { url } from '../data/curriculum';
import { pageMeta } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { noindex = false } = Astro.props;
const meta = pageMeta({ ...Astro.props, pathname: Astro.url.pathname,
  site: Astro.site!, imagePath: url('og.png') });
---
<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={meta.canonicalUrl} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Economía Financiera" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonicalUrl} />
    <meta property="og:image" content={meta.imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Economía Financiera: curso interactivo y visual" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.imageUrl} />
    <meta name="twitter:image:alt" content="Economía Financiera: curso interactivo y visual" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href={url()}>
        <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
          <path d="M3 22 H16 L29 9" fill="none" stroke="var(--c-return)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="16" cy="22" r="3" fill="var(--c-fv)" />
        </svg>
        <span>Economía Financiera</span>
      </a>
      <div class="header-actions">
        <slot name="header-actions" />
        <ThemeToggle />
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <span>© 2026 Jesus Villota Miranda</span>
      <span aria-hidden="true">·</span>
      <a rel="license" href="https://creativecommons.org/licenses/by/4.0/">Contenido del curso: CC BY 4.0</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/jesusvillota/economia-financiera/blob/main/LICENSE">Código: MIT</a>
    </footer>
  </body>
</html>

<script>
  // Wide tables and display equations need keyboard scrolling on small screens.
  const tables = document.querySelectorAll<HTMLElement>('.prose > table, .katex-display');
  const observer = new ResizeObserver(() => {
    for (const table of tables) table.tabIndex = table.scrollWidth > table.clientWidth + 1 ? 0 : -1;
  });
  for (const table of tables) observer.observe(table);
</script>

<style>
  .skip-link { position: fixed; left: -999px; top: 0; }
  .skip-link:focus { left: 1rem; top: 0.5rem; z-index: 100; background: var(--bg-raised); padding: 0.5rem 1rem; }
  .site-header {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.5rem 1rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-ui);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--text); text-decoration: none; font-weight: 600; font-size: 1rem; }
  /* A backdrop filter confines fixed children to the header instead of the viewport. */
  .site-header:has(:global(.mobile-nav[open])) { backdrop-filter: none; background: var(--bg); }
  .header-actions { display: flex; align-items: center; gap: 0.5rem; }
  .site-footer {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.4rem;
    padding: 1.5rem 1rem; border-top: 1px solid var(--border);
    font-family: var(--font-ui); font-size: 0.75rem; color: var(--text-muted);
  }
  .site-footer a { color: inherit; }
  .site-footer a:hover { color: var(--link); }
</style>
