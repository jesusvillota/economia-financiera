---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parts, sessions, finalExam, url } from '../data/curriculum';

const available = new Map((await getCollection('chapters')).map((c) => [c.data.chapter, c]));
const first = available.get(1);
const dots = (n: number) => '●'.repeat(n);
const levels = ['introductorio', 'intermedio', 'avanzado'];
---
<BaseLayout title="Economía Financiera">
  <main id="main" tabindex="-1" class="home">
    <section class="hero">
      <svg class="hero-art" viewBox="0 0 400 180" aria-hidden="true">
        <line x1="20" y1="150" x2="380" y2="150" stroke="var(--axis)" stroke-width="1.5" />
        <path d="M20 140 C140 135 260 100 380 20" fill="none" stroke="var(--c-fv)" stroke-width="5" stroke-linecap="round" />
        <path d="M20 140 L380 80" fill="none" stroke="var(--c-pv)" stroke-width="3" stroke-linecap="round" opacity="0.6" />
        <circle cx="20" cy="140" r="6" fill="var(--c-pv)" />
      </svg>
      <h1>Economía Financiera</h1>
      <p class="lede">
        Un curso interactivo y visual. Primero ves la imagen, después la fórmula, y puedes mover los deslizadores tú mismo.
      </p>
      <p class="pitch">21 capítulos en cinco partes, más una pista aparte de sesiones de problemas con ejercicios que cambian cada vez.</p>
      {first && <a class="cta" href={url(`chapters/${first.id}/`)}>Empezar por el capítulo 1 →</a>}
      <ul class="legend" aria-label="Código de colores del curso">
        <li><span class="sw" style="background: var(--c-pv)"></span>valor actual <i>VA</i></li>
        <li><span class="sw" style="background: var(--c-fv)"></span>valor futuro <i>VF</i></li>
        <li><span class="sw" style="background: var(--c-rate)"></span>tasa <i>r</i></li>
        <li><span class="sw" style="background: var(--c-risk)"></span>riesgo</li>
        <li><span class="sw" style="background: var(--c-return)"></span>rentabilidad</li>
      </ul>
    </section>

    <section class="map" aria-labelledby="map-title">
      <h2 id="map-title">El curso</h2>
      <div class="parts">
        {parts.map((part) => (
          <section class="part">
            <header>
              <span class="roman">{part.roman}</span>
              <h3>{part.title}</h3>
              <span class="diff" title="Dificultad">{part.difficulty}</span>
            </header>
            <ol>
              {part.chapters.map((ch) => {
                const entry = available.get(ch.number);
                return (
                  <li class:list={{ soon: !entry }}>
                    <span class="n">{ch.number}</span>
                    <div class="body">
                      {entry ? <a href={url(`chapters/${entry.id}/`)}>{ch.title}</a> : <span class="t">{ch.title}</span>}
                      <span class="meta">
                        <span class="diff" title={`Dificultad: ${levels[ch.difficulty - 1]}`}>{dots(ch.difficulty)}</span>
                        {ch.prerequisites.length > 0 && <span>Antes: cap. {ch.prerequisites.join(', ')}</span>}
                        {!entry && <span class="badge">Próximamente</span>}
                      </span>
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </section>

    <section class="map track" aria-labelledby="track-title">
      <h2 id="track-title">Sesiones de problemas</h2>
      <p class="map-intro">Una segunda pista, independiente de los capítulos: ejercicios con datos que cambian, pistas graduales y solución paso a paso.</p>
      <div class="parts">
        {sessions.map((s) => (
          <section class="part">
            <header><h3>{s.title}</h3></header>
            <p class="meta"><span>Usa los capítulos {s.chapters.join(', ')}</span><span class="badge">Próximamente</span></p>
          </section>
        ))}
        <section class="part">
          <header><h3><a href={url(`sesiones/${finalExam.slug}/`)}>{finalExam.title}</a></h3></header>
          <p class="meta"><span>Usa los capítulos {finalExam.chapters.join(', ')}</span><span class="badge">Niveles 1–3</span></p>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home { max-width: 70rem; margin: 0 auto; padding: 0 1.5rem 5rem; }
  .hero { max-width: 44rem; margin: 0 auto; padding: 3.5rem 0 3rem; text-align: center; }
  .hero-art { width: min(100%, 360px); height: auto; margin-bottom: 1rem; }
  .pitch { color: var(--text-muted); margin: 0 0 1.6rem; }
  .hero h1 { font-size: clamp(2.4rem, 7vw, 3.6rem); margin: 0 0 1rem; }
  .lede { font-size: 1.25rem; color: var(--text-muted); margin: 0 0 2rem; }
  .cta {
    display: inline-block; padding: 0.8rem 1.6rem; border-radius: 999px;
    background: var(--c-pv); color: var(--bg); font-family: var(--font-ui); font-weight: 600; text-decoration: none;
  }
  .cta:hover { filter: brightness(1.1); }
  .legend { list-style: none; padding: 0; margin: 2.2rem 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.1rem; font-family: var(--font-ui); font-size: 0.85rem; color: var(--text-muted); }
  .legend li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .sw { width: 0.8rem; height: 0.8rem; border-radius: 3px; display: inline-block; }

  .map h2 { text-align: center; font-size: 1.9rem; margin: 1rem 0 0.4rem; }
  .map-intro { text-align: center; color: var(--text-muted); margin: 0 auto 2rem; max-width: 36rem; }
  .parts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }
  .part { background: var(--bg-raised); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.1rem; font-family: var(--font-ui); }
  .part header { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.6rem; }
  .roman { color: var(--c-fv); font-weight: 700; font-size: 0.9rem; min-width: 2.2em; }
  .part h3 { font-family: var(--font-ui); font-size: 1rem; margin: 0; flex: 1; }
  .diff { color: var(--c-time); font-size: 0.7rem; letter-spacing: 0.1em; white-space: nowrap; }
  ol { list-style: none; margin: 0; padding: 0; font-size: 0.9rem; line-height: 1.4; }
  li { display: flex; gap: 0.6rem; padding: 0.25rem 0; }
  .n { color: var(--text-muted); min-width: 2.2em; font-variant-numeric: tabular-nums; }
  li a { color: var(--text); font-weight: 600; text-decoration: none; }
  li a:hover { color: var(--c-pv); }
  .body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.2rem 0.7rem; font-size: 0.75rem; color: var(--text-muted); margin: 0; }
  .meta .diff { font-size: 0.65rem; }
  .badge { border: 1px solid var(--border); border-radius: 999px; padding: 0 0.5rem; }
  .track { margin-top: 3rem; }
  .soon { color: var(--text-muted); opacity: 0.65; }
</style>
