---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/curriculum';
---
<BaseLayout title="Página no encontrada" description="Esta página no existe. Vuelve al índice del curso o consulta el glosario de Economía Financiera." noindex>
  <main id="main" tabindex="-1" class="not-found">
    <p class="code">404</p>
    <h1>Página no encontrada</h1>
    <p>Puede que el enlace haya cambiado o que la dirección esté mal escrita.</p>
    <nav aria-label="Continuar en el curso">
      <a href={url()}>Volver al índice del curso →</a>
      <a href={url('glosario/')}>Consultar el glosario →</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .not-found { max-width: 42rem; min-height: 65vh; margin: 0 auto; padding: 4rem 1.5rem; }
  .code { color: var(--c-fv); font: 600 1.25rem var(--font-ui); margin: 0; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); }
  p { color: var(--text-muted); }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; font-family: var(--font-ui); }
  nav a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
