---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CashFlowTimeline from '../../components/plots/CashFlowTimeline';
import GrowthCurves from '../../components/plots/GrowthCurves';
---
<BaseLayout title="Galería de widgets (desarrollo)">
  <main id="main" class="gallery">
    <h1>Galería de widgets</h1>
    <CashFlowTimeline client:visible />
    <GrowthCurves client:visible />
  </main>
</BaseLayout>

<style>
  .gallery { max-width: 40rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
</style>
