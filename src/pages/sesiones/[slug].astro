---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ejercicio from '../../components/sesiones/Ejercicio';
import Progreso from '../../components/sesiones/Progreso';
import { url } from '../../data/curriculum';

export async function getStaticPaths() {
  const sesiones = (await getCollection('sesiones')).sort((a, b) => a.data.number - b.data.number);
  return sesiones.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: sesiones[i - 1], next: sesiones[i + 1] } }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, summary, exercises, number, chapters } = entry.data;
const relatedChapters = (await getCollection('chapters')).filter((chapter) => chapters.includes(chapter.id));
---
<BaseLayout title={title} description={summary}>
  <main id="main" class="ses-page">
    <article class="prose">
      <header class="chapter-header">
        <p class="eyebrow">Sesión {number} · <Progreso client:load slug={entry.id} total={exercises.length} /></p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
      </header>
      <Content />
      <nav aria-label="Capítulos de esta sesión">
        <p>Repasa los conceptos:</p>
        <ul>
          {relatedChapters.map((chapter) => <li><a href={url(`chapters/${chapter.id}/`)}>{chapter.data.title}</a></li>)}
        </ul>
      </nav>
    </article>
    {exercises.map((ex, i) => <Ejercicio client:load slug={entry.id} index={i} exercise={ex} />)}
    <nav class="prev-next" aria-label="Navegación entre sesiones">
      {prev ? <a class="prev" href={url(`sesiones/${prev.id}/`)}><span class="label">← Anterior</span><span class="t">{prev.data.title}</span></a> : <span />}
      <a class="next" href={url('sesiones/')}><span class="label">Todas</span><span class="t">Sesiones</span></a>
      {next && <a class="next" href={url(`sesiones/${next.id}/`)}><span class="label">Siguiente →</span><span class="t">{next.data.title}</span></a>}
    </nav>
  </main>
</BaseLayout>
